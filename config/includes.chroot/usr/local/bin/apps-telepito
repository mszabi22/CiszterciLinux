#!/bin/bash
# apps-telepito – grafikus programtelepítő a /usr/local/bin/apps mappához
# Debian 13 + Xfce | függőségek: zenity, polkit (pkexec)
#
# Támogatott fájltípusok az APPS_DIR-ben:
#   *.deb        -> apt-get install (függőségekkel együtt), root jog kell (pkexec)
#   *.sh         -> root-ként lefuttatott telepítő script (pkexec)
#   *.AppImage   -> felhasználói szintű telepítés (~/.local/opt + menüelem)
#
# Opcionális "szép nevek" fájl: $APPS_DIR/names.txt
#   fájlnév | Megjelenő név | Rövid leírás
#   (a # kezdetű sorok megjegyzések)

APPS_DIR="/usr/local/bin/apps"
NAMES_FILE="$APPS_DIR/names.txt"
TITLE="MyApps - Programtelepítő"
SELF="$(readlink -f "$0")"

trim() {
    local s="$1"
    s="${s#"${s%%[![:space:]]*}"}"
    s="${s%"${s##*[![:space:]]}"}"
    printf '%s' "$s"
}

slugify() { printf '%s' "$1" | tr -c 'A-Za-z0-9._-' '_'; }

############################################################
# ROOT RÉSZ – pkexec-en keresztül hívódik: apps-telepito --root-install <fájlnév>
############################################################
root_install() {
    local f="$1" path p
    if [[ -z "$f" || "$f" == */* ]]; then
        echo "Érvénytelen fájlnév." >&2; exit 2
    fi
    path="$APPS_DIR/$f"
    if [[ ! -f "$path" || -L "$path" ]]; then
        echo "Nincs ilyen fájl: $f" >&2; exit 2
    fi
    # Biztonság: a mappa és a fájl csak rooté lehet, és más nem írhatja
    for p in "$APPS_DIR" "$path" "$SELF"; do
        if [[ "$(stat -c %u "$p")" != 0 ]] || [[ "$(stat -c %a "$p")" =~ ([2367][0-7]|[0-7][2367])$ ]]; then
            echo "Biztonsági hiba: $p nem rooté, vagy mások is írhatják." >&2
            exit 3
        fi
    done

    export DEBIAN_FRONTEND=noninteractive
    case "${f,,}" in
        *.deb) apt-get install -y "$path" ;;
        *.sh)  bash "$path" ;;
        *)     echo "Nem támogatott fájltípus: $f" >&2; exit 2 ;;
    esac
}

if [[ "$1" == "--root-install" ]]; then
    root_install "$2"
    exit $?
fi

############################################################
# GRAFIKUS RÉSZ
############################################################
if ! command -v zenity >/dev/null; then
    echo "Hiányzik a zenity. Telepítés: sudo apt install zenity" >&2
    exit 1
fi
if [[ ! -d "$APPS_DIR" ]]; then
    zenity --error --title="$TITLE" --text="Nem található a mappa:\n$APPS_DIR"
    exit 1
fi

# --- szép nevek betöltése ---
declare -A NAME DESC
if [[ -r "$NAMES_FILE" ]]; then
    while IFS='|' read -r file name desc; do
        file="$(trim "$file")"
        [[ -z "$file" || "$file" == \#* ]] && continue
        NAME["$file"]="$(trim "$name")"
        DESC["$file"]="$(trim "$desc")"
    done < "$NAMES_FILE"
fi

is_installed() {
    local f="$1" path="$APPS_DIR/$1" pkg
    case "${f,,}" in
        *.deb)
            pkg="$(dpkg-deb -f "$path" Package 2>/dev/null)"
            [[ -n "$pkg" ]] && dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | grep -q "install ok installed"
            ;;
        *.appimage)
            [[ -f "$HOME/.local/share/applications/apps-telepito-$(slugify "${f%.*}").desktop" ]]
            ;;
        *) return 1 ;;
    esac
}

install_appimage() {
    local f="$1" label slug dest
    label="${NAME[$f]:-${f%.*}}"
    slug="$(slugify "${f%.*}")"
    dest="$HOME/.local/opt/apps-telepito"
    mkdir -p "$dest" "$HOME/.local/share/applications" || return 1
    install -m 755 "$APPS_DIR/$f" "$dest/$f" || return 1
    cat > "$HOME/.local/share/applications/apps-telepito-$slug.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=$label
Exec="$dest/$f" %U
Icon=application-x-executable
Terminal=false
Categories=Utility;
EOF
}

install_one() {
    local f="$1"
    echo "=== $f ==="
    case "${f,,}" in
        *.appimage)  install_appimage "$f" ;;
        *.deb|*.sh)  pkexec "$SELF" --root-install "$f" ;;
        *) echo "Nem támogatott fájltípus: $f"; return 1 ;;
    esac
}

# --- lista összeállítása ---
rows=()
shopt -s nullglob nocaseglob
for path in "$APPS_DIR"/*.deb "$APPS_DIR"/*.sh "$APPS_DIR"/*.AppImage; do
    f="${path##*/}"
    name="${NAME[$f]:-${f%.*}}"
    desc="${DESC[$f]}"
    if is_installed "$f"; then
        name="✔ $name"
        desc="${desc:+$desc  }(már telepítve)"
    fi
    rows+=(FALSE "$name" "$desc" "$f")
done
shopt -u nullglob nocaseglob

if ((${#rows[@]} == 0)); then
    zenity --info --title="$TITLE" --text="Nincs telepíthető program a(z) $APPS_DIR mappában."
    exit 0
fi

selected="$(zenity --list --checklist \
    --title="$TITLE" --width=750 --height=500 \
    --text="Jelöld be a telepíteni kívánt programokat:" \
    --column="" --column="Program" --column="Leírás" --column="Fájl" \
    --hide-column=4 --print-column=4 --separator='/' \
    --ok-label="Telepítés" --cancel-label="Kilépés" \
    "${rows[@]}")" || exit 0
[[ -z "$selected" ]] && exit 0
IFS='/' read -ra files <<< "$selected"

# --- telepítés ---
log="$(mktemp)"
ok=(); fail=()
for f in "${files[@]}"; do
    label="${NAME[$f]:-${f%.*}}"
    install_one "$f" >>"$log" 2>&1 &
    pid=$!
    tail --pid="$pid" -f /dev/null 2>/dev/null | zenity --progress --pulsate --auto-close --no-cancel \
        --title="$TITLE" --width=400 --text="Telepítés folyamatban: $label ..." || true
    if wait "$pid"; then ok+=("$label"); else fail+=("$label"); fi
done

# --- eredmény ---
msg=""
((${#ok[@]}))   && msg+="Sikeresen telepítve:\n$(printf ' • %s\n' "${ok[@]}")\n"
((${#fail[@]})) && msg+="\nSikertelen:\n$(printf ' • %s\n' "${fail[@]}")"

if ((${#fail[@]})); then
    zenity --warning --title="$TITLE" --text="$msg" --width=400
    zenity --text-info --title="$TITLE – részletek" --filename="$log" --width=700 --height=400
else
    zenity --info --title="$TITLE" --text="$msg" --width=400
fi
rm -f "$log"
