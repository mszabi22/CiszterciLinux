[Unit]
Description=Kolibri: hiányzó Flatpak alkalmazások pótlása
After=network-online.target
Wants=network-online.target
ConditionKernelCommandLine=!boot=live
ConditionPathExists=!/var/lib/kolibri/flatpak-apps-done

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/kolibri-flatpak-apps
TimeoutStartSec=1800

[Install]
WantedBy=multi-user.target
