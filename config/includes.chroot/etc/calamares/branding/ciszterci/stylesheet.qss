/* Ciszterci Linux - telepítő stílus (a rendszer palettája: tengerkék, türkiz, borostyán) */
* {
    font-family: "Noto Sans", "DejaVu Sans", sans-serif;
}

QWidget {
    background-color: #0d2136;
    color: #e8eef4;
}

QLabel, QCheckBox, QRadioButton, QGroupBox {
    background-color: transparent;
}

QToolTip {
    background-color: #06111e;
    color: #e8eef4;
    border: 1px solid #1b8f8a;
}

/* Gombok */
QPushButton {
    background-color: #17344f;
    color: #e8eef4;
    border: 1px solid #2c4b68;
    border-radius: 5px;
    padding: 7px 18px;
}
QPushButton:hover    { background-color: #1e4262; border-color: #2ec4b6; }
QPushButton:pressed  { background-color: #14304a; }
QPushButton:disabled { color: #6b7f93; background-color: #0f2740; border-color: #1c3550; }
QPushButton:default, QPushButton:focus { border: 2px solid #f4b942; }

/* Beviteli mezők, listák */
QLineEdit, QComboBox, QSpinBox, QPlainTextEdit, QTextEdit {
    background-color: #0a1a2c;
    color: #e8eef4;
    border: 1px solid #2c4b68;
    border-radius: 4px;
    padding: 5px 8px;
    selection-background-color: #2ec4b6;
    selection-color: #06111e;
}
QLineEdit:focus, QComboBox:focus { border: 2px solid #2ec4b6; }
QComboBox QAbstractItemView {
    background-color: #0a1a2c;
    selection-background-color: #2ec4b6;
    selection-color: #06111e;
    border: 1px solid #2c4b68;
}

QListView, QTreeView, QTableView, QListWidget {
    background-color: #0a1a2c;
    alternate-background-color: #0d2136;
    border: 1px solid #2c4b68;
    border-radius: 4px;
    selection-background-color: #2ec4b6;
    selection-color: #06111e;
}
QHeaderView::section {
    background-color: #17344f;
    color: #e8eef4;
    border: 0;
    padding: 4px 8px;
}

/* Jelölők */
QCheckBox::indicator, QRadioButton::indicator { width: 16px; height: 16px; }
QCheckBox::indicator:unchecked, QRadioButton::indicator:unchecked {
    border: 1px solid #5d7a96; background-color: #0a1a2c; border-radius: 3px;
}
QRadioButton::indicator:unchecked { border-radius: 8px; }
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    border: 1px solid #2ec4b6; background-color: #2ec4b6; border-radius: 3px;
}
QRadioButton::indicator:checked { border-radius: 8px; }

/* Telepítési folyamatjelző */
QProgressBar {
    background-color: #0a1a2c;
    border: 0;
    border-radius: 3px;
    height: 6px;
    text-align: center;
    color: #e8eef4;
}
QProgressBar::chunk { background-color: #2ec4b6; border-radius: 3px; }

/* Görgetősávok */
QScrollBar:vertical   { background: #0a1a2c; width: 12px; margin: 0; }
QScrollBar:horizontal { background: #0a1a2c; height: 12px; margin: 0; }
QScrollBar::handle:vertical, QScrollBar::handle:horizontal { background: #2c4b68; border-radius: 5px; min-height: 24px; min-width: 24px; }
QScrollBar::handle:hover { background: #3a7ca5; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }

QSplitter::handle { background-color: #17344f; }
QToolButton { background-color: transparent; border: 0; }
QToolButton:hover { background-color: #17344f; }
