#!/bin/bash
# Az ISO indítómenüjében mindenhol "Ciszterci Linux" szerepeljen.
D=binary; [ -d "$D/boot" ] || D=.
files=$(ls "$D"/boot/grub/*.cfg "$D"/boot/grub/*/*.cfg "$D"/boot/grub/live-theme/theme.txt \
           "$D"/isolinux/*.cfg "$D"/isolinux/*.txt 2>/dev/null || true)
for f in $files; do
  sed -i -e 's/Debian GNU\/Linux/Ciszterci Linux/g' \
         -e 's/Debian Live/Ciszterci Linux/g' \
         -e 's/Live system/Ciszterci Linux - Live/g' "$f"
done
exit 0
