#!/bin/bash
# Plymouth téma beállítása (a telepített rendszerbe is átkerül)
set -e
if [ -d /usr/share/plymouth/themes/ciszterci ]; then
    plymouth-set-default-theme ciszterci
    update-initramfs -u || true
fi

# GRUB menü: "Ciszterci Linux GNU/Linux" helyett "Ciszterci Linux".
# A 10_linux-hoz nem nyúlunk (nincs divert): minden apt/dpkg futás után átírjuk a grub.cfg-t.
cat > /etc/apt/apt.conf.d/99ciszterci-grub <<'EOF'
DPkg::Post-Invoke { "[ -f /boot/grub/grub.cfg ] && sed -i 's|Ciszterci Linux GNU/Linux|Ciszterci Linux|g' /boot/grub/grub.cfg || true"; };
EOF
exit 0