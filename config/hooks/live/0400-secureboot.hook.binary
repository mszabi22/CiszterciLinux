#!/bin/bash
# Secure Boot támogatás az élő ISO-hoz: az efi.img-t az aláírt
# shim -> grub láncból építjük újra. A binary_iso lépés előtt fut.
set -e

IMG=binary/boot/grub/efi.img
[ -d binary/boot/grub ] || { echo "HIBA: binary/boot/grub nincs, rossz munkakönyvtár?"; exit 1; }

# Az első létező fájlt adja vissza (a trixie-ben a shim fájlok .latest végződést kaphatnak)
pick() { for p in "$@"; do [ -f "$p" ] && { echo "$p"; return 0; }; done; return 1; }

S=chroot/usr/lib/shim
G=chroot/usr/lib/grub/x86_64-efi-signed
SHIM=$(pick $S/shimx64.efi.signed $S/shimx64.efi.signed.latest $S/shimx64.efi.signed.previous) || true
MM=$(pick   $S/mmx64.efi.signed   $S/mmx64.efi.signed.latest   $S/mmx64.efi.signed.previous)   || true
GRUB=$(pick $G/grubx64.efi.signed) || true

if [ -z "$SHIM" ] || [ -z "$MM" ] || [ -z "$GRUB" ]; then
    echo "HIBA: nem találom az aláírt EFI fájlokat. Ami van:"
    ls -l $S $G 2>&1 || true
    exit 1
fi
echo "shim: $SHIM"; echo "mm:   $MM"; echo "grub: $GRUB"

T=$(mktemp -d)
trap 'rm -rf "$T"' EXIT
mkdir -p "$T/EFI/boot" "$T/EFI/debian"

cp "$SHIM" "$T/EFI/boot/bootx64.efi"
cp "$MM"   "$T/EFI/boot/mmx64.efi"
cp "$GRUB" "$T/EFI/boot/grubx64.efi"
cp "$GRUB" "$T/EFI/debian/grubx64.efi"

cat > "$T/EFI/boot/grub.cfg" <<'EOF'
search --file --set=root /boot/grub/grub.cfg
set prefix=($root)/boot/grub
configfile /boot/grub/grub.cfg
EOF
cp "$T/EFI/boot/grub.cfg" "$T/EFI/debian/grub.cfg"

rm -f "$IMG"
truncate -s 16M "$IMG"
mkfs.vfat -n CISZTERCI_EFI "$IMG" >/dev/null
mcopy -s -i "$IMG" "$T/EFI" ::

mdir -/ -i "$IMG" ::EFI
exit 0
