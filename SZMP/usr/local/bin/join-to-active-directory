#!/bin/bash
echo "Active Directory member? (i/n)"
read ADMEMBER_INSTALL
if [ $ADMEMBER_INSTALL = 'i' ]; then
#AD rules
firewall-cmd --permanent --zone=public --add-port=137/udp --add-port=137/tcp
firewall-cmd --permanent --zone=public --add-port=138/udp --add-port=138/tcp
firewall-cmd --permanent --zone=public --add-port=139/udp --add-port=139/tcp
firewall-cmd --permanent --zone=public --add-port=67/udp --add-port=67/tcp
firewall-cmd --permanent --zone=public --add-port=68/udp --add-port=68/tcp

firewall-cmd --permanent --zone=public --add-port=53/udp --add-port=53/tcp
firewall-cmd --permanent --zone=public --add-port=389/udp --add-port=389/tcp
firewall-cmd --permanent --zone=public --add-port=636/udp --add-port=636/tcp
firewall-cmd --permanent --zone=public --add-port=88/udp --add-port=88/tcp
firewall-cmd --permanent --zone=public --add-port=464/udp --add-port=464/tcp
firewall-cmd --permanent --zone=public --add-port=445/udp --add-port=445/tcp
firewall-cmd --permanent --zone=public --add-port=123/udp --add-port=123/tcp
firewall-cmd --reload	
	deluser user
	rm -rf /home/user
	apt -y install realmd sssd sssd-tools libnss-sss libpam-sss adcli samba-common-bin oddjob oddjob-mkhomedir packagekit 
	echo "Domain name?"
	read DOMAINNAME
	echo "User name?"
	read USERNAME
	realm discover $DOMAINNAME
	realm join --user=$USERNAME $DOMAINNAME
	id $USERNAME@$DOMAINNAME
	echo "session required pam_mkhomedir.so skel=/etc/skel/ umask=0022" |  tee -a /etc/pam.d/common-session
	echo "$USERNAME@$DOMAINNAME ALL=(ALL) ALL" |  tee -a /etc/sudoers.d/domain_admins
	mcedit /etc/sssd/sssd.conf
	systemctl restart sssd 

	#realm leave --user=pingvin $DOMAINNAME	

echo "[Desktop Entry]
Type=Application
Exec=/usr/local/bin/bookmarks.sh
Hidden=false
NoDisplay=false
X-GNOME-Autostart-enabled=true
Name=Bookmarks Setup
Comment=Setup GTK Bookmarks for network shares
" > /etc/xdg/autostart/bookmarks.desktop
chmod +x /etc/xdg/autostart/bookmarks.desktop
